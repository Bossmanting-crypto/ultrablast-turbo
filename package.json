{
  "name": "ultrablast-turbo-android",
  "version": "1.0.0",
  "private": true,
  "description": "Ultrablast Turbo, mobile edition. A Capacitor Android app.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "vendor": "node scripts/vendor.mjs",
    "sync": "npm run build && npx cap sync android",
    "serve": "npm run build && node scripts/serve.mjs",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@fontsource/bungee": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "three": "0.160.0"
  }
}