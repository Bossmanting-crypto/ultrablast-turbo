{
  "appId": "com.ultrablast.turbo",
  "appName": "Ultrablast Turbo",
  "webDir": "www",
  "android": {
    "backgroundColor": "#0a0b22",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "SystemBars": {
      "hidden": true,
      "style": "DARK",
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
